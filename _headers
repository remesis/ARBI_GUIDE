/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY

# WFG2 chunks are precompressed Brotli streams. Their filenames contain
# the decoded mesh hash, so a changed mesh gets a new immutable URL.
/3d_tilesets/data/*.wfg2.br
  Content-Type: application/octet-stream
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable, no-transform
  Vary: Accept-Encoding

# Versioned authored viewer assets are shared by every map and cache permanently.
/3d_tilesets/data/author/*
  Cache-Control: public, max-age=31536000, immutable

# Overlay filenames are content-addressed too.
/3d_tilesets/data/*.wfo
  Cache-Control: public, max-age=31536000, immutable

# The manifest maps stable routes to content-addressed geometry/overlays.
/3d_tilesets/data/maps.json
  Cache-Control: no-cache

/3d_tilesets/meshopt_decoder.1.0.1.js
  Cache-Control: public, max-age=31536000, immutable
